# Salin file ini menjadi .env lalu sesuaikan nilainya: cp .env.example .env

# API key Google Cloud (Drive API sudah diaktifkan)
GOOGLE_API_KEY=your_google_api_key_here

# Kunci master editor untuk akses dashboard editor
EDITOR_KEY=your_admin_secret_key_here

# Nomor WhatsApp editor default, format 628xxxxxxxxxx
EDITOR_WA=6281234567890

# PORT=3000 # Opsional (hanya untuk server lokal, default 3000)
# APP_URL=https://namadomain-anda.com # Opsional (default: otomatis mendeteksi dari browser/request header)

# =========================================================================
# FIREBASE REALTIME DATABASE (100% GRATIS SELAMANYA TANPA KARTU KREDIT)
# Rekomendasi: Spark Plan (Free)
# =========================================================================
# Buat Realtime Database di Firebase Console lalu tempelkan URL-nya di sini:
# FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# Kredensial Service Account (Jika sudah Anda miliki, otomatis dipakai untuk RTDB):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"

# Alternatif: Jika tidak ingin menggunakan Private Key, bisa gunakan Database Secret:
# FIREBASE_DATABASE_SECRET=your_database_secret_here

# =========================================================================
# FIREBASE CLOUD STORAGE (OPSIONAL / JIKA MENGGUNAKAN GCS BUCKET)
# =========================================================================
# FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'
